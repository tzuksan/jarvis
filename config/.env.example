# JARVIS Environment Variables Template

Copy this file to `.env` and fill in your actual values.

## LLM & Vision
OPENAI_API_KEY=sk-... # Get from https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_VISION_MODEL=gpt-4-vision-preview

## Speech
WHISPER_API_KEY=sk-... # Same OpenAI key works
WHISPER_MODEL=whisper-1
TTS_PROVIDER=edge_tts # Options: edge_tts, openai_tts

## Database
DATABASE_URL=sqlite:///./jarvis_data.db

## PC Agent
PC_AGENT_HOST=0.0.0.0
PC_AGENT_PORT=8000
PC_AGENT_WORKERS=4

## Android Connection (for emulator: 10.0.2.2)
PC_AGENT_URL=ws://localhost:8000/ws

## Logging
LOG_LEVEL=INFO # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/jarvis.log

## Development
DEBUG=False # Set to True for verbose logging
ENVIRONMENT=development # Options: development, staging, production

## Security
ALLOW_TOOL_CONFIRMATION=True # Require user confirmation for destructive operations
TOOL_EXECUTION_TIMEOUT=30 # Seconds

## Voice
VOICE_DEVICE=default # microphone device name
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1

## Browser (Phase 2)
FIREFOX_PATH=firefox # or full path to Firefox binary
GECKODRIVER_PATH=geckodriver # or full path to geckodriver

## OBS Integration (Phase 3)
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD= # Set this if OBS has password protection

## Memory & Learning (Phase 4)
EMBEDDING_MODEL=text-embedding-ada-002 # OpenAI embeddings
MEMORY_RETENTION_DAYS=365

## Future: Cloud Sync (Phase 4+)
CLOUD_SYNC_URL=https://sync.jarvis.local # When implemented
CLOUD_API_KEY= # Optional cloud authentication

## Features (Flags for enabling/disabling features)
ENABLE_VOICE_INPUT=True
ENABLE_VISION=True # Requires OpenAI Vision
ENABLE_BROWSER_AGENT=False # Phase 2
ENABLE_OBS_CONTROL=False # Phase 3
ENABLE_PC_AUTOMATION=False # Phase 3
ENABLE_CLOUD_SYNC=False # Phase 4+
ENABLE_MEMORY_LEARNING=False # Phase 4+

## Performance
MAX_CONVERSATION_HISTORY=50 # Turns to keep in context
CACHE_TTL_SECONDS=300 # LLM response cache duration
SYNC_BATCH_SIZE=100 # Items per sync batch
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=5 # Seconds

## Security (Don't store passwords here!)
ALLOWED_PROGRAMS=firefox,notepad,vlc,obs64 # Comma-separated whitelist
BLOCKED_PROGRAMS=cmd,powershell,regedit # Programs that can never run
ALLOW_FILE_DELETE=False # Require extra confirmation for file deletion
MAX_FILE_SIZE_MB=100 # Max file for some operations

## Notifications
NOTIFICATION_SOUND=True
NOTIFICATION_POPUP=True
NOTIFICATION_TIMEOUT=5 # Seconds

## Debugging
VERBOSE_TOOL_LOGGING=False # Log all tool calls in detail
SAVE_CONVERSATION_LOGS=True # Save conversations for debugging
PROFILE_PERFORMANCE=False # Enable performance profiling

## Notes
# - Never commit this file to git (it's in .gitignore)
# - For production, use secure secret management
# - Set DEBUG=False for production
# - API costs can accumulate; monitor OpenAI usage
# - For Android emulator: Use 10.0.2.2 for PC_AGENT_URL
# - For real device: Use actual IP (e.g., 192.168.1.100)
